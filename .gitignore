# never commit Ricoh firmware, decoded images or exports
work/
*.bin
*.BIN
# except our own RAM loader, built from tools/ramload/load.c by build.sh
!tools/ramload/bin/LOAD.BIN
unpackedFW*
# photos carry the camera serial number in their metadata
*.DNG
*.dng
*.JPG
*.jpg
# tutorial images: canvas renders and screenshots, no camera metadata
!editor/static/tutorial/**/*.jpg
# python
.venv/
__pycache__/
*.pyc
.DS_Store
# rust
core/target/
editor/static/_local/
editor/static/pkg/
